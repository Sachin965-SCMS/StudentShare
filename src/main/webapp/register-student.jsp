<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Student Registration</title><link rel="stylesheet" href="${pageContext.request.contextPath}/static/css/app.css"><script src="${pageContext.request.contextPath}/static/js/app.js" defer></script></head><body><div class="container"><div class="card center-card"><h1>Student registration</h1><p class="muted">The college admin must approve this account before login.</p><form class="form" method="post" action="${pageContext.request.contextPath}/register/student"><div class="field"><label>Name</label><input name="name" required></div><div class="field"><label>Email</label><input type="email" name="email" required></div><div class="field"><label>Password</label><input type="password" name="password" minlength="8" required></div><div class="field"><label>College</label><select id="collegeId" name="collegeId" required><option>Loading…</option></select></div><button class="btn">Submit registration</button></form><p class="small"><a href="${pageContext.request.contextPath}/login.jsp">Back to login</a></p></div></div></body></html>
