<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Login | StudentShare</title><link rel="stylesheet" href="${pageContext.request.contextPath}/static/css/app.css"></head><body><div class="container"><div class="card center-card"><h1>Sign in</h1><p class="muted">Use an approved account.</p><%if(request.getParameter("error")!=null){%><div class="flash error"><c:out value="${param.error}"/></div><%}%><%if(request.getParameter("message")!=null){%><div class="flash info"><c:out value="${param.message}"/></div><%}%><form class="form" method="post" action="${pageContext.request.contextPath}/login"><div class="field"><label>Email</label><input type="email" name="email" required></div><div class="field"><label>Password</label><input type="password" name="password" required></div><button class="btn">Login</button></form><p class="small muted">Register: <a href="${pageContext.request.contextPath}/register-student.jsp">student</a> · <a href="${pageContext.request.contextPath}/register-supervisor.jsp">supervisor</a> · <a href="${pageContext.request.contextPath}/register-admin.jsp">college admin</a></p></div></div></body></html>
