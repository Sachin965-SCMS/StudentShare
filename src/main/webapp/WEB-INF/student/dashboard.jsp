<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Student Dashboard</title><link rel="stylesheet" href="${pageContext.request.contextPath}/static/css/app.css"></head><body><div class="topbar"><div class="brand">StudentShare · Student</div><div class="nav"><a href="${pageContext.request.contextPath}/student/dashboard">Materials</a><a href="${pageContext.request.contextPath}/student/upload">Upload</a><form method="post" action="${pageContext.request.contextPath}/logout"><button class="btn small">Logout</button></form></div></div><div class="container"><div class="hero"><h1>Materials</h1><p>Browse materials shared within your college.</p></div><c:if test="${not empty sessionScope.flashMessage}"><div class="flash ${sessionScope.flashType}" data-hide>${sessionScope.flashMessage}</div><c:remove var="flashMessage" scope="session"/><c:remove var="flashType" scope="session"/></c:if><form id="filterForm" class="filters" method="get" action="${pageContext.request.contextPath}/student/dashboard"><div class="field"><label>Course</label><select name="courseId" onchange="this.form.submit()"><option value="">All courses</option><c:forEach items="${courses}" var="c"><option value="${c.id}" <c:if test="${selectedCourseId == c.id}">selected</c:if>><c:out value="${c.code}"/> - <c:out value="${c.name}"/></option></c:forEach></select></div><div class="field"><label>Type</label><select name="type" onchange="this.form.submit()"><option value="ALL" <c:if test="${selectedType == 'ALL'}">selected</c:if>>All types</option><option value="PDF" <c:if test="${selectedType == 'PDF'}">selected</c:if>>PDF</option><option value="PPT" <c:if test="${selectedType == 'PPT'}">selected</c:if>>PPT</option><option value="QUESTION_PAPER" <c:if test="${selectedType == 'QUESTION_PAPER'}">selected</c:if>>Question paper</option><option value="NOTES" <c:if test="${selectedType == 'NOTES'}">selected</c:if>>Notes</option></select></div><div class="field"><label>Sort</label><select name="sort" onchange="this.form.submit()"><option value="RECENT" <c:if test="${selectedSort == 'RECENT'}">selected</c:if>>Recent first</option><option value="OLDEST" <c:if test="${selectedSort == 'OLDEST'}">selected</c:if>>Oldest first</option><option value="RATING" <c:if test="${selectedSort == 'RATING'}">selected</c:if>>Highest rated</option></select></div><div class="filter-reset"><a class="btn secondary" href="${pageContext.request.contextPath}/student/dashboard">Reset</a></div></form><div class="material-grid"><c:forEach items="${materials}" var="m"><div class="card material"><span class="badge"><c:out value="${m.materialType}"/></span><h3><c:out value="${m.title}"/></h3><p class="muted small"><c:out value="${m.courseName}"/> · <c:out value="${m.uploaderName}"/></p><p><c:out value="${m.description}"/></p><div><span class="rating">★ ${m.averageRating}</span> <span class="muted small">(${m.ratingCount} rating(s))</span></div><div class="material-footer"><a class="btn small" href="${pageContext.request.contextPath}/materials/download?id=${m.id}" target="_blank">View PDF</a><form method="post" action="${pageContext.request.contextPath}/student/rate"><input type="hidden" name="materialId" value="${m.id}"><select name="rating"><option value="5">5★</option><option value="4">4★</option><option value="3">3★</option><option value="2">2★</option><option value="1">1★</option></select><button class="btn small secondary">Rate</button></form></div></div></c:forEach><c:if test="${empty materials}"><div class="empty">No materials match these filters.</div></c:if></div></div></body></html>
