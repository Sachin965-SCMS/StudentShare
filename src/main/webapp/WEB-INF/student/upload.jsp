<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Upload Material</title><link rel="stylesheet" href="${pageContext.request.contextPath}/static/css/app.css"></head><body><div class="topbar"><div class="brand">StudentShare · Upload</div><div class="nav"><a href="${pageContext.request.contextPath}/student/dashboard">Materials</a><form method="post" action="${pageContext.request.contextPath}/logout"><button class="btn small">Logout</button></form></div></div><div class="container"><div class="card"><h1>Upload material</h1><p class="muted">Current version accepts PDF files up to 15 MB. The material category is stored independently so PPT/question-paper/notes filters are already supported.</p><c:if test="${not empty error}"><div class="flash error"><c:out value="${error}"/></div></c:if><form class="form" method="post" action="${pageContext.request.contextPath}/student/upload" enctype="multipart/form-data"><div class="row"><div class="field"><label>Course</label><select name="courseId" required><option value="">Select course</option><c:forEach items="${courses}" var="c"><option value="${c.id}"><c:out value="${c.code}"/> - <c:out value="${c.name}"/></option></c:forEach></select></div><div class="field"><label>Material type</label><select name="type" required><option value="PDF">PDF</option><option value="NOTES">Notes</option><option value="PPT">PPT</option><option value="QUESTION_PAPER">Question paper</option></select></div></div><div class="field"><label>Title</label><input name="title" maxlength="180" required></div><div class="field"><label>Description</label><textarea name="description" maxlength="500"></textarea></div><div class="field"><label>PDF file</label><input type="file" name="file" accept="application/pdf,.pdf" required></div><button class="btn">Upload</button></form></div></div></body></html>
