<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Courses</title><link rel="stylesheet" href="${pageContext.request.contextPath}/static/css/app.css"></head><body><div class="topbar"><div class="brand">StudentShare · Courses</div><div class="nav"><a href="${pageContext.request.contextPath}/admin/dashboard">Dashboard</a><a href="${pageContext.request.contextPath}/admin/pending">Approvals</a><form method="post" action="${pageContext.request.contextPath}/logout"><button class="btn small">Logout</button></form></div></div><div class="container"><div class="section-title"><div><h1>Course structure</h1><p class="muted">Create courses with semesters and subject lists.</p></div><a class="btn" href="${pageContext.request.contextPath}/admin/course/create">Add course</a></div><c:if test="${not empty sessionScope.flashMessage}"><div class="flash ${sessionScope.flashType}">${sessionScope.flashMessage}</div><c:remove var="flashMessage" scope="session"/><c:remove var="flashType" scope="session"/></c:if><div class="card table-wrap"><table class="table"><thead><tr><th>Code</th><th>Course</th><th>Semesters</th></tr></thead><tbody><c:forEach items="${courses}" var="c"><tr><td><c:out value="${c.code}"/></td><td><c:out value="${c.name}"/></td><td>${c.semesterCount}</td></tr></c:forEach><c:if test="${empty courses}"><tr><td colspan="3">No courses created yet.</td></tr></c:if></tbody></table></div></div></body></html>
