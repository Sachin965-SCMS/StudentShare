<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Add Course</title><link rel="stylesheet" href="${pageContext.request.contextPath}/static/css/app.css"><script src="${pageContext.request.contextPath}/static/js/app.js" defer></script></head><body><div class="topbar"><div class="brand">StudentShare · Add Course</div><div class="nav"><a href="${pageContext.request.contextPath}/admin/courses">Back</a></div></div><div class="container"><div class="card"><h1>Add course</h1><p class="muted">Choose the semester count and subject count/name for every semester.</p><%if(request.getAttribute("error")!=null){%><div class="flash error"><c:out value="${error}"/></div><%}%><form class="form" method="post" action="${pageContext.request.contextPath}/admin/course/create"><div class="row"><div class="field"><label>Course code</label><input name="code" placeholder="BCA" required></div><div class="field"><label>Course name</label><input name="name" placeholder="Bachelor of Computer Applications" required></div></div><div class="field"><label>Number of semesters</label><input id="semesterCount" type="number" min="1" max="20" value="6" name="semesterCount" required></div><div id="semesterFields"></div><button class="btn">Create course structure</button></form></div></div></body></html>
