<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Admin Dashboard</title><link rel="stylesheet" href="${pageContext.request.contextPath}/static/css/app.css"></head><body><div class="topbar"><div class="brand">StudentShare · Admin</div><div class="nav"><a href="${pageContext.request.contextPath}/admin/courses">Courses</a><a href="${pageContext.request.contextPath}/admin/pending">Approvals</a><form method="post" action="${pageContext.request.contextPath}/logout"><button class="btn small">Logout</button></form></div></div><div class="container"><div class="hero"><h1>Welcome, <c:out value="${sessionScope.userName}"/></h1><p>Manage course structure and account approvals.</p></div><c:if test="${not empty sessionScope.flashMessage}"><div class="flash ${sessionScope.flashType}" data-hide>${sessionScope.flashMessage}</div><c:remove var="flashMessage" scope="session"/><c:remove var="flashType" scope="session"/></c:if><div class="grid"><div class="card"><h3>Courses</h3><p>${courses.size()} configured course(s).</p><a class="btn" href="${pageContext.request.contextPath}/admin/courses">Manage courses</a></div><div class="card"><h3>Pending approvals</h3><p>${pending.size()} account request(s) waiting.</p><a class="btn" href="${pageContext.request.contextPath}/admin/pending">Review requests</a></div></div></div></body></html>
