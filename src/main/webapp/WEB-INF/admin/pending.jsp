<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Approvals</title><link rel="stylesheet" href="${pageContext.request.contextPath}/static/css/app.css"></head><body><div class="topbar"><div class="brand">StudentShare · Approvals</div><div class="nav"><a href="${pageContext.request.contextPath}/admin/dashboard">Dashboard</a><a href="${pageContext.request.contextPath}/admin/courses">Courses</a><form method="post" action="${pageContext.request.contextPath}/logout"><button class="btn small">Logout</button></form></div></div><div class="container"><h1>Pending account approvals</h1><c:if test="${not empty sessionScope.flashMessage}"><div class="flash ${sessionScope.flashType}">${sessionScope.flashMessage}</div><c:remove var="flashMessage" scope="session"/><c:remove var="flashType" scope="session"/></c:if><div class="card table-wrap"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Course ID</th><th>Action</th></tr></thead><tbody><c:forEach items="${pending}" var="u"><tr><td><c:out value="${u.name}"/></td><td><c:out value="${u.email}"/></td><td>${u.role}</td><td>${u.courseId}</td><td><form method="post" action="${pageContext.request.contextPath}/admin/approval" style="display:inline"><input type="hidden" name="userId" value="${u.id}"><input type="hidden" name="status" value="APPROVED"><button class="btn small">Approve</button></form> <form method="post" action="${pageContext.request.contextPath}/admin/approval" style="display:inline"><input type="hidden" name="userId" value="${u.id}"><input type="hidden" name="status" value="REJECTED"><button class="btn small danger">Reject</button></form></td></tr></c:forEach><c:if test="${empty pending}"><tr><td colspan="5">No pending requests.</td></tr></c:if></tbody></table></div></div></body></html>
