<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Supervisor Dashboard</title><link rel="stylesheet" href="${pageContext.request.contextPath}/static/css/app.css"></head><body><div class="topbar"><div class="brand">StudentShare · Supervisor</div><div class="nav"><a href="${pageContext.request.contextPath}/supervisor/dashboard">Materials</a><form method="post" action="${pageContext.request.contextPath}/logout"><button class="btn small">Logout</button></form></div></div><div class="container"><div class="hero"><h1><c:out value="${course.name}"/> materials</h1><p>Only materials belonging to your assigned course are shown.</p></div><c:if test="${not empty sessionScope.flashMessage}"><div class="flash ${sessionScope.flashType}" data-hide>${sessionScope.flashMessage}</div><c:remove var="flashMessage" scope="session"/><c:remove var="flashType" scope="session"/></c:if><div class="material-grid"><c:forEach items="${materials}" var="m"><div class="card material"><span class="badge"><c:out value="${m.materialType}"/></span><h3><c:out value="${m.title}"/></h3><p class="muted small"><c:out value="${m.uploaderName}"/> · ${m.createdAt}</p><p><c:out value="${m.description}"/></p><div><span class="rating">★ ${m.averageRating}</span> <span class="muted small">(${m.ratingCount})</span></div><div class="material-footer"><a class="btn small" href="${pageContext.request.contextPath}/materials/download?id=${m.id}" target="_blank">View PDF</a><form method="post" action="${pageContext.request.contextPath}/supervisor/delete" onsubmit="return confirm('Delete this material?');"><input type="hidden" name="materialId" value="${m.id}"><button class="btn small danger">Delete</button></form></div></div></c:forEach><c:if test="${empty materials}"><div class="empty">No materials have been uploaded for this course yet.</div></c:if></div></div></body></html>
