<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>StudentShare</title><link rel="stylesheet" href="${pageContext.request.contextPath}/static/css/app.css"></head><body><div class="topbar"><div class="brand">StudentShare</div><div class="nav"><a href="${pageContext.request.contextPath}/login.jsp">Login</a><a href="${pageContext.request.contextPath}/register-student.jsp">Student registration</a><a href="${pageContext.request.contextPath}/register-supervisor.jsp">Supervisor registration</a><a href="${pageContext.request.contextPath}/register-admin.jsp">Admin registration</a></div></div><div class="container"><section class="hero"><h1>Study material sharing for your college.</h1><p>Students share notes within their institution, supervisors manage materials for their course, and administrators control course setup and account approvals.</p></section><div class="grid"><div class="card"><h3>Admin</h3><p>Create the college account, configure courses, semesters and subjects, and approve student/supervisor accounts.</p></div><div class="card"><h3>Supervisor</h3><p>See and remove materials belonging to your own course only.</p></div><div class="card"><h3>Student</h3><p>Browse, filter, upload PDF materials and rate materials on a five-point scale.</p></div></div></div></body></html>
