<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>College Admin Registration</title><link rel="stylesheet" href="${pageContext.request.contextPath}/static/css/app.css"></head><body><div class="container"><div class="card center-card"><h1>College admin registration</h1><p class="muted">Creates the main account for one college.</p><form class="form" method="post" action="${pageContext.request.contextPath}/register/admin"><div class="field"><label>College name</label><input name="collegeName" required maxlength="150"></div><div class="field"><label>College email</label><input type="email" name="email" required></div><div class="field"><label>Password</label><input type="password" name="password" minlength="8" required></div><button class="btn">Register college</button></form><p class="small"><a href="${pageContext.request.contextPath}/login.jsp">Back to login</a></p></div></div></body></html>
